<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Dashboard</title>
    <link rel="stylesheet" href="/assets/admin.css">
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.js"></script>
        
</head>
<body>

    <div class="dashboard-container">
        <aside class="sidebar">
            <div class="sidebar-header">
                <a href="#">Trang quản trị</a>
            </div>
            <nav class="sidebar-nav">
                <ul>
                    <li class="nav-item active" data-section="dashboard">
                        <i class="icon">📈</i> <span>Tổng quan</span>
                    </li>
                    <li class="nav-item" data-section="stories">
                        <i class="icon">📚</i> <span>Quản lý Truyện</span>
                    </li>
                    <li class="nav-item">
                        <i class="icon">📑</i> <span>Quản lý Chương</span>
                    </li>
                    <li class="nav-item">
                        <i class="icon">👥</i> <span>Quản lý Người dùng</span>
                    </li>
                    <li class="nav-item">
                        <i class="icon">📰</i> <span>Báo cáo</span>
                    </li>
                    <li class="nav-item">
                        <i class="icon">✔️</i> <span>Trung tâm Duyệt</span>
                    </li>
                </ul>
            </nav>
        </aside>

        <main class="main-content">
            <header class="header">
              <div class="search-bar"></div>

              <div class="header-icons">
                  <button id="theme-toggle" title="Chuyển chế độ sáng/tối">🌙</button>
                  <i class="icon profile-pic">👤</i>
              </div>
            </header>

            <div class="dashboard-body" id="dashboard-section">
                <h1>Tổng quan</h1>
                <p>Tổng quan hệ thống quản lý truyện</p>

                <div class="stats-grid">
                        <div class="stat-card">
                            <div class="card-content">
                                <h3>Tổng Người dùng</h3>
                                <p id="total-users" class="value">—</p>
                            </div>
                            <i class="card-icon">👥</i>
                        </div>

                        <div class="stat-card">
                            <div class="card-content">
                                <h3>Tổng Truyện</h3>
                                <p id="total-stories" class="value">—</p>
                            </div>
                            <i class="card-icon">📚</i>
                        </div>

                        <div class="stat-card">
                            <div class="card-content">
                                <h3>Tổng Chương</h3>
                                <p id="total-chapters" class="value">—</p>
                            </div>
                            <i class="card-icon">📑</i>
                        </div>

                        <div class="stat-card">
                            <div class="card-content">
                                <h3>Tổng Lượt Đọc</h3>
                                <p id="total-reads" class="value">—</p>
                            </div>
                            <i class="card-icon">📈</i>
                        </div>

                        <div class="stat-card revenue">
                            <div class="card-content">
                                <h3>Doanh thu</h3>
                                <p id="total-revenue" class="value">—</p>
                            </div>
                            <i class="card-icon">💰</i>
                        </div>
                    </div>

                <div class="charts-section">
                    <div class="chart-box">
                        <h3>Lượt đọc hàng ngày (30 ngày)</h3>
                        <canvas id="readingChart"></canvas>
                    </div>
                    <div class="chart-box">
                        <h3>Doanh thu (VNĐ)</h3>
                        <canvas id="revenueVndChart"></canvas>
                    </div>
                </div>
                
                <div class="charts-section">
                    <div class="chart-box">
                        <h3>Báo cáo gần đây</h3>
                        <div id="recentReports" style="max-height: 300px; overflow-y: auto;">
                            <table style="width: 100%; font-size: 13px; border-collapse: collapse;">
                                <thead>
                                    <tr style="border-bottom: 1px solid #ddd;">
                                        <th style="text-align: left; padding: 8px;">Chương</th>
                                        <th style="text-align: left; padding: 8px;">Nội dung</th>
                                        <th style="text-align: left; padding: 8px;">Người báo cáo</th>
                                        <th style="text-align: center; padding: 8px;">Trạng thái</th>
                                    </tr>
                                </thead>
                                <tbody id="reportsBody">
                                    <tr><td colspan="4" style="padding: 8px; text-align: center; color: #999;">Đang tải...</td></tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <div class="dashboard-body hidden-section" id="stories-section">
                <div class="page-header">
                    <h1>Quản lý Truyện</h1>
                    <p>Quản lý tất cả truyện trên hệ thống</p>
                </div>

                <div class="filters-container">
                    <div class="filter-dropdown">
                        <span>Lọc:</span> 
                    </div>
                    
                    <div class="search-bar">
                        <input id="admin-search-input" type="text" placeholder="Tìm kiếm truyện, tác giả, người dùng...">
                    </div>

                    <div id="status-filter" class="filter-dropdown" tabindex="0">
                        <span id="status-label">Tất cả trạng thái</span>
                        <i class="icon dropdown-arrow">▾</i>
                        <div class="dropdown-menu">
                            <div data-value="all">Tất cả trạng thái</div>
                            <div data-value="published">Đã duyệt</div>
                            <div data-value="pending">Chờ duyệt</div>
                            <div data-value="rejected">Từ chối</div>
                        </div>
                    </div>
                </div>

                <div class="stories-list-header">
                    Danh sách truyện (<span id="stories-count">0</span>)
                </div>
                <div class="stories-table-container">
                    <table class="stories-table">
                        <thead>
                            <tr>
                                <th style="width: 35%;">Tên truyện</th>
                                <th style="width: 20%;">Tác giả</th>
                                <th style="width: 15%;">Trạng thái</th>
                                <th style="width: 20%;">Ngày tạo</th>
                                <th style="width: 10%;">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody id="storiesTableBody">
                            <tr><td colspan="5" style="padding: 20px; text-align: center; color: #999;">Đang tải...</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
            
            <!-- Delete confirmation modal -->
            <div id="confirmModal" class="modal-backdrop" role="dialog" aria-hidden="true">
                <div class="modal" role="document">
                    <h3>Xác nhận xóa</h3>
                    <p>Bạn có chắc muốn xóa truyện này? Hành động không thể hoàn tác.</p>
                    <div class="modal-actions">
                        <button id="cancelDeleteBtn" class="btn ghost">Hủy</button>
                        <button id="confirmDeleteBtn" class="btn danger">Xóa</button>
                    </div>
                </div>
            </div>
        </main>
    </div>

</body>
</html>

<script src="/assets/admin.js"></script>